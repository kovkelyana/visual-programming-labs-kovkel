    {
        "id": "aa8cb67137300235",
        "type": "function",
        "z": "e541113b6565977d",
        "name": "function 4",
        "func": "// === Получаем query-параметр id ===\nconst idRaw = msg.req.query.id;\n\n// === Проверка 1: параметр обязателен ===\nif (!idRaw) {\n    msg.statusCode = 400;\n    msg.payload = {\n        status: \"error\",\n        code: 400,\n        message: \"Параметр 'id' обязателен. Пример: /api/items?id=3\"\n    };\n    return msg;\n}\n\n// === Проверка 2: id должен быть числом ===\nconst id = Number(idRaw);\nif (isNaN(id)) {\n    msg.statusCode = 400;\n    msg.payload = {\n        status: \"error\",\n        code: 400,\n        message: \"Параметр 'id' должен быть числом\"\n    };\n    return msg;\n}\n\n// === Проверка 3: id в допустимом диапазоне (1..5) ===\nif (id < 1 || id > 5) {\n    msg.statusCode = 404;\n    msg.payload = {\n        status: \"error\",\n        code: 404,\n        message: `Товар с id=${id} не найден. Доступны id от 1 до 5`\n    };\n    return msg;\n}\n\n// === Успех: возвращаем \"товар\" ===\nmsg.statusCode = 200;\nmsg.payload = {\n    status: \"ok\",\n    item: {\n        id: id,\n        name: `Товар №${id}`,\n        price: id * 100\n    }\n};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
