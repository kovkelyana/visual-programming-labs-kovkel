    {
        "id": "af830daf027cb902",
        "type": "function",
        "z": "48eb664ae61516d9",
        "name": "function 2",
        "func": "// === Настройки ===\nconst input = msg.payload;       // число из inject (7)\nconst names = [\"Аня\", \"Борис\", \"Вика\", \"Глеб\", \"Даша\"];\n\n// === Проверка типа ===\nlet status;\nif (typeof input !== \"number\") {\n    status = \"Ошибка: payload не число\";\n} else if (input < 0) {\n    status = \"Отрицательное\";\n} else {\n    status = \"Положительное\";\n}\n\n// === Цикл for — сумма чисел от 1 до input ===\nlet sum = 0;\nfor (let i = 1; i <= input; i++) {\n    sum += i;\n}\n\n// === Цикл for...of — перебор массива ===\nconst upperNames = [];\nfor (const name of names) {\n    upperNames.push(name.toUpperCase());\n}\n\n// === Возвращаем объект с полем payload ===\nmsg.payload = {\n    input: input,\n    status: status,\n    sum: sum,\n    names: upperNames,\n    count: upperNames.length\n};\n\nreturn msg;",
