    {
        "id": "8aeb0f5b03ed0d21",
        "type": "function",
        "z": "158c81c70f6e5d7c",
        "name": "function 8",
        "func": "// Получаем текущее значение счётчика из flow context\n// Если его ещё нет — начинаем с 0\nlet counter = flow.get(\"counter\") || 0;\n\n// Увеличиваем счётчик\ncounter = counter + 1;\n\n// Сохраняем обратно в flow context\nflow.set(\"counter\", counter);\n\n// Возвращаем значение в debug\nmsg.payload = {\n    counter: counter,\n    action: \"increment\"\n};\nreturn msg;",
