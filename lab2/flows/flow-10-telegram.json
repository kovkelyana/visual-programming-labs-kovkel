        "z": "2c2ca2b9573d2fb5",
        "name": "function 6",
        "func": "// Echo: возвращаем тот же текст, что прислал пользователь\n// Извлекаем данные из объекта, который прислал Telegram receiver\n\nconst chatId = msg.payload.chatId;\nconst text = msg.payload.content || \"(пустое сообщение)\";\n\nmsg.payload = {\n    chatId: chatId,\n    type: \"message\",\n    content: \"Эхо: \" + text\n};\n\nreturn msg;",
