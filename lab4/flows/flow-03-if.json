        "jsCode": "// Логика аналогична flow-02\nconst surname = 'kovkel';\nlet counter = 0;\n\nconst subjects = ['n8n', 'docker', 'redis', 'low-code'];\n\nconst info = {\n  student: surname,\n  lab: 4,\n  group: 'УИР-241'\n};\n\nfor (let i = 0; i < subjects.length; i++) {\n  if (subjects[i].length > 4) {\n    counter++;\n  } else {\n    counter += 0;\n  }\n}\n\n// Возвращаем объект с полем payload и флагом для IF\nreturn [{\n  json: {\n    payload: `Student ${info.student}, lab ${info.lab}. Long words: ${counter}.`,\n    counter: counter\n  }\n}];"
